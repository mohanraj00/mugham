{
  "format": 2,
  "name": "citation",
  "version": "0.1.0",
  "kind": "component",
  "description": "The source of a claim: a source name, a locator as text, an optional quote and an open button.",
  "ai_content": true,
  "slots": {
    "authorship": {
      "required": true
    },
    "citation": {
      "required": false
    }
  },
  "data": {
    "quote": {
      "type": "text",
      "label": "Quote",
      "required": false,
      "max_length": 500
    }
  },
  "states": [
    "default",
    "empty",
    "refused"
  ],
  "tokens": [
    "color.text",
    "color.text-muted",
    "color.border",
    "space.1",
    "space.2",
    "space.3",
    "radius.2",
    "type.body",
    "type.caption"
  ],
  "accessibility": {
    "role": "group",
    "name": {
      "text": "Citation"
    },
    "keyboard": [
      "Tab",
      "Shift+Tab",
      "Enter",
      "Space"
    ],
    "forced_colors": true,
    "reduced_motion": true
  }
}
