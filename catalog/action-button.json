{
  "name": "action-button",
  "description": "A button for one bound action. It can ask for confirmation and shows done only after a receipt. A pending action with no receipt offers retry and cancel. The default display is text. The button also shows text if there is no icon. In icon display the label shows on hover and focus.",
  "ai_content": false,
  "data": {
    "label": {"type": "text", "required": true, "min_length": 1, "size": "short"},
    "description": {"type": "text", "size": "summary"},
    "icon": {"type": "enum", "values": ["check", "cross", "edit", "delete", "send", "retry"]},
    "display": {"type": "enum", "values": ["text", "icon", "both"]}
  },
  "states": ["+disabled", "+confirm", "+pending", "+done", "+error"],
  "tokens": [
    "color.accent", "color.on-accent", "color.surface", "color.text", "color.border", "color.text-muted", "color.danger", "color.focus", "space.1", "space.2",
    "space.3", "radius.2", "type.body", "type.caption", "motion.fast"
  ],
  "accessibility": {"role": "button", "name": {"field": "label"}, "keyboard": ["Tab", "Shift+Tab", "Enter", "Space", "Escape"]}
}
