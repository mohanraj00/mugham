{
  "name": "range-field",
  "kind": "primitive",
  "description": "One or two named sliders each have a named number box. A native label names the first slider. A pair has a named group. Values use steps from the minimum and stay in range and in order. An invalid edit keeps the last value and shows the reason, with the limits for a number outside the range.",
  "ai_content": false,
  "data": {
    "name": {"type": "text", "size": "short"},
    "label": {"type": "text", "required": true, "min_length": 1, "size": "line"},
    "value": {"type": "number-or-pair", "required": true, "editable": true},
    "minimum": {"type": "number", "required": true},
    "maximum": {"type": "number", "required": true},
    "step": {"type": "number", "required": true},
    "hint": {"type": "text", "size": "summary"},
    "error": {"type": "text", "size": "summary"},
    "disabled": {"type": "boolean"},
    "typed": {"type": "boolean"}
  },
  "states": ["+disabled", "+error"],
  "tokens": [
    "+color.surface", "+color.text-muted", "+color.accent", "+color.focus", "+color.danger",
    "+space.1", "+space.2", "+radius.1", "+type.caption"
  ],
  "accessibility": {
    "role": "slider",
    "name": {"field": "label"},
    "keyboard": ["Tab", "Shift+Tab", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", "PageUp", "PageDown"]
  }
}
