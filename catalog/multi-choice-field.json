{
  "name": "multi-choice-field",
  "kind": "primitive",
  "description": "A labeled field for more than one choice. Up to seven choices show as checkboxes. Longer lists use removable tags and a search box. Give unique values in choice order within the optional count limits. An omitted value gives an empty list.",
  "ai_content": false,
  "data": {
    "name": {"type": "text", "size": "short"},
    "label": {"type": "text", "required": true, "min_length": 1, "size": "line"},
    "value": {
      "type": "list",
      "editable": true,
      "max_items": 500,
      "unique_items": true,
      "items": {"type": "text", "label": "Choice", "min_length": 1, "size": "line"}
    },
    "choices": {
      "type": "list",
      "required": true,
      "min_items": 1,
      "max_items": 500,
      "unique_items": true,
      "items": {"type": "text", "label": "Choice", "min_length": 1, "size": "line"}
    },
    "min_items": {"type": "integer", "minimum": 0, "maximum": 500},
    "max_items": {"type": "integer", "minimum": 0, "maximum": 500},
    "hint": {"type": "text", "size": "summary"},
    "error": {"type": "text", "size": "summary"},
    "disabled": {"type": "boolean"},
    "typed": {"type": "boolean"}
  },
  "states": ["+disabled", "+error"],
  "tokens": [
    "+color.surface", "+color.text-muted", "+color.accent", "+color.focus", "+color.danger", "+space.1",
    "+space.2", "+radius.1", "+type.caption", "+type.weight-strong", "+motion.fast"
  ],
  "accessibility": {
    "role": "group",
    "name": {"field": "label"},
    "keyboard": ["Tab", "Shift+Tab", "Enter", "Space", "Escape", "ArrowUp", "ArrowDown", "Home", "End"]
  }
}
