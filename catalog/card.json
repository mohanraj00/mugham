{
  "name": "card",
  "description": "A card with a title, optional details and an optional collapse control.",
  "slots": {"citation": {"required": false}},
  "parts": [
    {"name": "actions", "description": "Area for action buttons.", "guardrail": false},
    {"name": "authorship", "description": "Type and ID of the author, with a name when available.", "guardrail": true},
    {"name": "body", "description": "Content that shows when the card is expanded.", "guardrail": true},
    {"name": "card", "description": "Card container.", "guardrail": false},
    {"name": "citation", "description": "Source of the content.", "guardrail": true},
    {"name": "collapsed-summary", "description": "Short text that shows when the card is collapsed.", "guardrail": false},
    {"name": "copy", "description": "Button that copies text.", "guardrail": true},
    {"name": "copy-status", "description": "Result of the copy operation.", "guardrail": true},
    {"name": "details", "description": "Control and technical details of a refusal.", "guardrail": true},
    {"name": "facts", "description": "List of facts.", "guardrail": false},
    {"name": "icon", "description": "Chevron of the collapse control.", "guardrail": true},
    {"name": "locator", "description": "Location in the source.", "guardrail": true},
    {"name": "next", "description": "Next step after a refusal.", "guardrail": true},
    {"name": "open", "description": "Button that opens the source.", "guardrail": true},
    {"name": "provenance", "description": "Group that shows the author and the source.", "guardrail": true},
    {"name": "reason", "description": "Reason for a refusal or an edit error.", "guardrail": true},
    {"name": "status", "description": "State text of the card.", "guardrail": true},
    {"name": "title", "description": "Title of the card.", "guardrail": false},
    {"name": "toggle", "description": "Button that expands or collapses the card.", "guardrail": true}
  ],
  "data": {
    "title": {"type": "text", "required": true, "min_length": 1, "size": "title"},
    "summary": {"type": "text", "max_length": 1000},
    "date": {"type": "date"},
    "date_label": {"type": "text", "size": "short"},
    "facts": {"type": "list", "max_items": 6, "items": {"type": "component", "label": "Fact", "name": "fact"}},
    "collapsible": {"type": "boolean", "label": "Collapse control"},
    "collapsed": {"type": "boolean", "label": "Start collapsed"},
    "status": {"type": "text", "size": "title"},
    "collapsed_summary": {"type": "text", "size": "summary"}
  },
  "states": ["+expanded", "+collapsed"],
  "tokens": [
    "color.surface", "color.text", "color.text-muted", "color.border", "space.2", "space.3", "space.4", "radius.2",
    "type.body", "type.caption", "type.weight-strong", "color.focus"
  ],
  "accessibility": {"role": "article", "name": {"field": "title"}, "keyboard": ["Tab", "Enter", "Space"]}
}
