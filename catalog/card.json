{
  "format": 1,
  "name": "card",
  "version": "0.1.0",
  "kind": "component",
  "description": "A card with a title, an optional summary, an optional date and up to six facts.",
  "ai_content": true,
  "data": {
    "title": {
      "type": "text",
      "label": "Title",
      "required": true,
      "min_length": 1,
      "max_length": 120
    },
    "summary": {
      "type": "text",
      "label": "Summary",
      "required": false,
      "max_length": 1000
    },
    "date": {
      "type": "date",
      "label": "Date",
      "required": false
    },
    "date_label": {
      "type": "text",
      "label": "Date label",
      "required": false,
      "max_length": 40
    },
    "facts": {
      "type": "list",
      "label": "Facts",
      "required": false,
      "max_items": 6,
      "items": {
        "type": "component",
        "label": "Fact",
        "required": true,
        "name": "fact"
      }
    }
  },
  "states": [
    "default"
  ],
  "tokens": [
    "color.surface",
    "color.text",
    "color.text-muted",
    "color.border",
    "space.2",
    "space.3",
    "space.4",
    "radius.2",
    "type.body",
    "type.caption",
    "type.weight-strong"
  ],
  "accessibility": {
    "role": "article",
    "name": {
      "field": "title"
    },
    "keyboard": [],
    "forced_colors": true,
    "reduced_motion": true
  }
}
