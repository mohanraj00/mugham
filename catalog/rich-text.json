{
  "format": 2,
  "name": "rich-text",
  "version": "0.1.0",
  "kind": "component",
  "description": "Rich text as a tree of typed nodes: paragraphs, headings, lists, code blocks and quotes. A fill gives data only, never markup. The kit makes each element from a fixed list. Page code sets the link schemes and the first heading level.",
  "ai_content": true,
  "slots": {
    "authorship": {
      "required": true
    }
  },
  "data": {
    "blocks": {
      "type": "list",
      "label": "Blocks",
      "required": true,
      "max_items": 100,
      "items": {
        "type": "component",
        "label": "Block",
        "required": true,
        "names": [
          "rich-paragraph",
          "rich-heading",
          "rich-list",
          "rich-code",
          "rich-quote"
        ]
      }
    },
    "clamp": {
      "type": "integer",
      "label": "Initial lines",
      "required": false,
      "minimum": 1,
      "maximum": 20
    }
  },
  "states": [
    "default",
    "empty",
    "refused"
  ],
  "tokens": [
    "color.text",
    "color.text-muted",
    "color.surface",
    "color.border",
    "color.accent",
    "color.focus",
    "space.1",
    "space.2",
    "space.3",
    "space.4",
    "radius.1",
    "type.body",
    "type.caption",
    "type.weight-strong"
  ],
  "accessibility": {
    "role": "none",
    "keyboard": [
      "Tab",
      "Shift+Tab",
      "Enter",
      "Space",
      "Escape"
    ],
    "forced_colors": true,
    "reduced_motion": true
  }
}
