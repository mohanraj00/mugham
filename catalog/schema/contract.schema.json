{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mohanraj00/mugham/catalog/schema/contract.schema.json",
  "title": "Mugham component contract, format 1",
  "type": "object",
  "required": ["format", "name", "version", "kind", "description", "ai_content", "data", "states", "tokens", "accessibility"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": 1},
    "name": {"$ref": "#/$defs/name"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})\\.(0|[1-9][0-9]{0,5})$"},
    "kind": {"enum": ["primitive", "component"]},
    "description": {"type": "string", "minLength": 1, "maxLength": 300},
    "ai_content": {"type": "boolean"},
    "data": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {"$ref": "#/$defs/field_name"},
      "additionalProperties": {"$ref": "#/$defs/field"}
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10,
      "propertyNames": {"$ref": "#/$defs/field_name"},
      "additionalProperties": {"$ref": "#/$defs/action"}
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"enum": ["default", "empty", "loading", "disabled", "pending", "done", "error", "refused"]}
    },
    "tokens": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]+(\\.[a-z0-9]+(-[a-z0-9]+)*){1,3}$"}
    },
    "accessibility": {
      "type": "object",
      "required": ["role", "keyboard", "forced_colors", "reduced_motion"],
      "additionalProperties": false,
      "properties": {
        "role": {"enum": ["article", "button", "form", "group", "list", "region", "status", "textbox", "none"]},
        "name": {
          "oneOf": [
            {"type": "object", "required": ["field"], "additionalProperties": false, "properties": {"field": {"$ref": "#/$defs/field_name"}}},
            {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 80}}}
          ]
        },
        "keyboard": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {"enum": ["Tab", "Shift+Tab", "Enter", "Space", "Escape", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"]}
        },
        "forced_colors": {"const": true},
        "reduced_motion": {"const": true}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "maxLength": 40, "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"},
    "field_name": {"type": "string", "maxLength": 40, "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 80},
    "field": {
      "oneOf": [
        {"$ref": "#/$defs/text_field"},
        {"$ref": "#/$defs/number_field"},
        {"$ref": "#/$defs/boolean_field"},
        {"$ref": "#/$defs/date_field"},
        {"$ref": "#/$defs/enum_field"},
        {"$ref": "#/$defs/list_field"},
        {"$ref": "#/$defs/component_field"}
      ]
    },
    "scalar_field": {
      "oneOf": [
        {"$ref": "#/$defs/text_field"},
        {"$ref": "#/$defs/number_field"},
        {"$ref": "#/$defs/boolean_field"},
        {"$ref": "#/$defs/date_field"},
        {"$ref": "#/$defs/enum_field"}
      ]
    },
    "text_field": {
      "type": "object",
      "required": ["type", "label", "required", "max_length"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "text"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "min_length": {"type": "integer", "minimum": 0, "maximum": 10000},
        "max_length": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "number_field": {
      "type": "object",
      "required": ["type", "label", "required"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["number", "integer"]},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "boolean_field": {
      "type": "object",
      "required": ["type", "label", "required"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "boolean"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"}
      }
    },
    "date_field": {
      "type": "object",
      "required": ["type", "label", "required"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "date"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"}
      }
    },
    "enum_field": {
      "type": "object",
      "required": ["type", "label", "required", "values"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "enum"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "editable": {"type": "boolean"},
        "values": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/field_name"}}
      }
    },
    "list_field": {
      "type": "object",
      "required": ["type", "label", "required", "items", "max_items"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "list"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "max_items": {"type": "integer", "minimum": 1, "maximum": 500},
        "items": {
          "oneOf": [
            {"$ref": "#/$defs/scalar_field"},
            {"$ref": "#/$defs/component_field"}
          ]
        }
      }
    },
    "component_field": {
      "type": "object",
      "required": ["type", "label", "required", "name"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "component"},
        "label": {"$ref": "#/$defs/label"},
        "required": {"type": "boolean"},
        "name": {"$ref": "#/$defs/name"}
      }
    },
    "action": {
      "type": "object",
      "required": ["tool", "label", "arguments", "confirm"],
      "additionalProperties": false,
      "properties": {
        "tool": {"type": "string", "maxLength": 80, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 40},
        "confirm": {"type": "boolean"},
        "arguments": {
          "type": "object",
          "maxProperties": 20,
          "propertyNames": {"$ref": "#/$defs/field_name"},
          "additionalProperties": {"$ref": "#/$defs/scalar_field"}
        }
      }
    }
  }
}
