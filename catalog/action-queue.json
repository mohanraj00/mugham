{
  "name": "action-queue",
  "description": "The actions of the offline queue of the application, each with its state as text and its exits. A waiting action shows as pending, never as done. The application fills it from its queue, not a model.",
  "ai_content": false,
  "data": {
    "label": {"type": "text", "required": true, "min_length": 1, "size": "line"},
    "actions": {
      "type": "list",
      "required": true,
      "max_items": 100,
      "items": {"type": "component", "label": "Action", "name": "queued-action"}
    }
  },
  "states": ["+empty", "+pending", "+error", "+refused"],
  "tokens": [
    "color.text", "color.text-muted", "color.border", "color.accent", "color.danger", "color.focus", "space.1",
    "space.2", "space.3", "radius.2", "type.body", "type.caption", "type.weight-strong", "motion.fast"
  ],
  "accessibility": {"role": "group", "name": {"field": "label"}, "keyboard": ["Tab", "Shift+Tab", "Enter", "Space"]}
}
