{
  "format": 2,
  "name": "status",
  "version": "0.1.0",
  "kind": "component",
  "description": "One state with short text. The application or service gives the state. Pending has a dashed border, Passed a solid border, Failed a double border and Unknown a dotted border. Each state shows its label as text.",
  "ai_content": true,
  "slots": {
    "authorship": {
      "required": true
    }
  },
  "data": {
    "state": {
      "type": "enum",
      "label": "State",
      "required": true,
      "values": [
        "pending",
        "passed",
        "failed",
        "unknown"
      ]
    },
    "text": {
      "type": "text",
      "label": "Text",
      "required": true,
      "min_length": 1,
      "max_length": 200
    }
  },
  "states": [
    "default",
    "refused"
  ],
  "tokens": [
    "color.text",
    "color.text-muted",
    "color.border",
    "space.1",
    "space.2",
    "space.3",
    "radius.2",
    "type.body",
    "type.caption",
    "type.weight-strong"
  ],
  "accessibility": {
    "role": "group",
    "name": {
      "field": "text"
    },
    "keyboard": [],
    "forced_colors": true,
    "reduced_motion": true
  }
}
