{
  "format": 2,
  "name": "form-line",
  "version": "0.1.0",
  "kind": "component",
  "description": "One line of a form card: an optional line number, a field and a read-only flag.",
  "ai_content": true,
  "slots": {
    "authorship": {
      "required": true
    }
  },
  "data": {
    "line": {
      "type": "text",
      "label": "Line number",
      "required": false,
      "min_length": 1,
      "max_length": 12
    },
    "read_only": {
      "type": "boolean",
      "label": "Read-only",
      "required": false
    },
    "field": {
      "type": "component",
      "label": "Field",
      "required": true,
      "names": [
        "field",
        "long-text-field",
        "number-field",
        "date-field",
        "choice-field"
      ]
    }
  },
  "states": [
    "default"
  ],
  "tokens": [
    "color.text",
    "color.text-muted",
    "space.1",
    "space.2",
    "type.body",
    "type.caption"
  ],
  "accessibility": {
    "role": "none",
    "keyboard": [],
    "forced_colors": true,
    "reduced_motion": true
  }
}
