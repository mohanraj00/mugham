{
  "format": 2,
  "name": "rich-span",
  "version": "0.1.0",
  "kind": "component",
  "description": "An inline text node of rich text, with one optional mark: emphasis, strong or code.",
  "ai_content": true,
  "slots": {
    "authorship": {
      "required": true
    }
  },
  "data": {
    "text": {
      "type": "text",
      "label": "Text",
      "required": true,
      "min_length": 1,
      "max_length": 2000
    },
    "mark": {
      "type": "enum",
      "label": "Mark",
      "required": false,
      "values": [
        "emphasis",
        "strong",
        "code"
      ]
    }
  },
  "states": [
    "default"
  ],
  "tokens": [
    "color.text",
    "color.border",
    "radius.1",
    "type.body",
    "type.weight-strong"
  ],
  "accessibility": {
    "role": "none",
    "keyboard": [],
    "forced_colors": true,
    "reduced_motion": true
  }
}
