{
  "format": 2,
  "name": "text",
  "version": "0.1.0",
  "kind": "primitive",
  "description": "A run of text. The kit always shows the value as text, never as markup.",
  "ai_content": false,
  "data": {
    "text": {
      "type": "text",
      "label": "Text",
      "required": true,
      "max_length": 10000
    },
    "variant": {
      "type": "enum",
      "label": "Variant",
      "required": false,
      "values": [
        "body",
        "strong",
        "caption"
      ]
    },
    "clamp": {
      "type": "integer",
      "label": "Initial lines",
      "required": false,
      "minimum": 1,
      "maximum": 20
    }
  },
  "states": [
    "default",
    "empty"
  ],
  "tokens": [
    "color.text",
    "color.text-muted",
    "type.body",
    "type.caption",
    "type.weight-strong",
    "color.accent",
    "color.focus",
    "space.1"
  ],
  "accessibility": {
    "role": "none",
    "keyboard": [
      "Tab",
      "Shift+Tab",
      "Enter",
      "Space"
    ],
    "forced_colors": true,
    "reduced_motion": true
  }
}
