{
  "name": "editable-form",
  "description": "A form with up to 20 fields for text, long text, numbers, ranges, dates, date ranges, times, dates with times, choices, selects, multiple choices and yes or no values. The form sends the values and the edit types as one action. A pending action offers retry and cancel.",
  "data": {
    "title": {"type": "text", "required": true, "min_length": 1, "size": "title"},
    "fields": {
      "type": "list",
      "required": true,
      "max_items": 20,
      "items": {
        "type": "component",
        "label": "Field",
        "names": ["field", "long-text-field", "number-field", "date-field", "choice-field", "toggle-field", "range-field", "select-field", "multi-choice-field", "date-range-field", "time-field", "date-time-field"]
      }
    },
    "submit_label": {"type": "text", "required": true, "min_length": 1, "size": "short"}
  },
  "states": ["+disabled", "+confirm", "+pending", "+done", "+error"],
  "tokens": [
    "color.surface", "color.text", "color.text-muted", "color.border", "color.accent", "color.on-accent",
    "color.danger", "color.success", "color.focus", "space.1", "space.2", "space.3", "space.4", "radius.2", "type.body", "type.caption",
    "type.weight-strong", "motion.fast"
  ],
  "accessibility": {"role": "form", "name": {"field": "title"}, "keyboard": ["Tab", "Shift+Tab", "Enter", "Space"]}
}
