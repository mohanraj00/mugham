{
  "name": "data-grid",
  "description": "An editable grid with column and row headers and typed cells. A person moves between cells with the keyboard and edits each cell in place. Each saved change goes to the application as one action. The cell shows a marker while it waits for a receipt. A successful receipt shows Done below the grid.",
  "data": {
    "label": {"type": "text", "required": true, "min_length": 1, "size": "title"},
    "columns": {
      "type": "list",
      "required": true,
      "max_items": 30,
      "items": {"type": "component", "label": "Column", "name": "data-grid-column"}
    },
    "rows": {
      "type": "list",
      "required": true,
      "max_items": 200,
      "items": {"type": "component", "label": "Row", "name": "data-grid-row"}
    }
  },
  "states": ["+empty", "+disabled", "+pending", "+error", "+refused"],
  "tokens": [
    "color.text", "color.text-muted", "color.surface", "color.border", "color.danger", "color.success", "space.1", "space.2", "space.3",
    "radius.1", "type.body", "type.caption", "type.weight-strong"
  ],
  "accessibility": {
    "role": "group",
    "name": {"field": "label"},
    "keyboard": [
      "Tab", "Shift+Tab", "Enter", "Escape", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End"
    ]
  }
}
