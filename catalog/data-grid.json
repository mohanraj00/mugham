{
  "name": "data-grid",
  "description": "A grid with typed cells. The status gives the reason for a wait. If no receipt comes back, the grid offers Retry and Cancel. Cancel keeps the sent edit Changed if it is the last edit of the cell. A newer edit stays ready to send. A successful receipt shows Done. The kit computes no formula.",
  "data": {
    "label": {"type": "text", "required": true, "min_length": 1, "size": "title"},
    "columns": {
      "type": "list",
      "required": true,
      "max_items": 30,
      "items": {"type": "component", "label": "Column", "name": "data-grid-column"}
    },
    "rows": {
      "type": "list",
      "required": true,
      "max_items": 200,
      "items": {"type": "component", "label": "Row", "name": "data-grid-row"}
    }
  },
  "states": ["+empty", "+disabled", "+pending", "+error", "+refused"],
  "tokens": [
    "color.text", "color.text-muted", "color.surface", "color.border", "color.danger", "color.success", "space.1", "space.2", "space.3",
    "radius.1", "type.body", "type.caption", "type.weight-strong"
  ],
  "accessibility": {
    "role": "group",
    "name": {"field": "label"},
    "keyboard": [
      "Tab", "Shift+Tab", "Enter", "Escape", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", "Space"
    ]
  }
}
