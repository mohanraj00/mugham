{
 "note": "Conformance cases for src/envelope/ and docs/contracts/envelope-v1.schema.json. tests/envelope.test.mjs checks each case. The data is synthetic. \"schema\" tells if the input agrees with the schema. \"result\" is the envelope that readEnvelope gives.",
 "fallback": "The kit does not know this part type, so it does not show the part.",
 "cases": [
  {
   "name": "a final text message of a person",
   "schema": true,
   "envelope": {
    "envelope": 1,
    "agui": "1.0",
    "threadId": "t-1",
    "messageId": "m-1",
    "role": "user",
    "actor": {
     "type": "human",
     "id": "person-a",
     "name": "Person A"
    },
    "state": "final",
    "parts": [
     {
      "type": "text",
      "text": "Is the loan due?"
     }
    ]
   },
   "result": {
    "envelope": 1,
    "agui": "1.0",
    "threadId": "t-1",
    "messageId": "m-1",
    "role": "user",
    "actor": {
     "type": "human",
     "id": "person-a",
     "name": "Person A"
    },
    "state": "final",
    "parts": [
     {
      "type": "text",
      "text": "Is the loan due?"
     }
    ]
   }
  },
  {
   "name": "a message with no actor is refused",
   "schema": false,
   "envelope": {
    "envelope": 1,
    "agui": "1.0",
    "threadId": "t-1",
    "messageId": "m-1",
    "role": "user",
    "state": "final",
    "parts": [
     {
      "type": "text",
      "text": "Hello"
     }
    ]
   },
   "result": {
    "envelope": 1,
    "agui": "1.0",
    "threadId": "t-1",
    "messageId": "m-1",
    "state": "refused",
    "errors": [
     "actor: a required field is missing"
    ]
   }
  },
  {
   "name": "an actor with an unknown type and an empty id is refused",
   "schema": false,
   "envelope": {
    "envelope": 1,
    "agui": "1.0",
    "messageId": "m-1",
    "actor": {
     "type": "robot",
     "id": ""
    },
    "state": "final",
    "parts": []
   },
   "result": {
    "envelope": 1,
    "agui": "1.0",
    "messageId": "m-1",
    "state": "refused",
    "errors": [
     "actor.type: must be human, agent or system",
     "actor.id: must be an id of 1 to 128 characters"
    ]
   }
  },
  {
   "name": "an unknown part type shows as a text fallback with no data",
   "schema": true,
   "envelope": {
    "envelope": 1,
    "agui": "1.0",
    "messageId": "m-1",
    "actor": {
     "type": "agent",
     "id": "agent-plan",
     "name": "Planner"
    },
    "state": "final",
    "parts": [
     {
      "type": "chart",
      "points": [
       1,
       2
      ],
      "html": "<b>x</b>"
     }
    ]
   },
   "result": {
    "envelope": 1,
    "agui": "1.0",
    "messageId": "m-1",
    "actor": {
     "type": "agent",
     "id": "agent-plan",
     "name": "Planner"
    },
    "state": "final",
    "parts": [
     {
      "type": "fallback",
      "partType": "chart",
      "text": "The kit does not know this part type, so it does not show the part."
     }
    ]
   }
  },
