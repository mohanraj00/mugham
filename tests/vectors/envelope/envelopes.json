 "note": "Conformance cases for src/envelope/ and docs/contracts/envelope-v1.schema.json. tests/envelope.test.mjs checks each case. The data is synthetic. \"schema\" tells if the input agrees with the schema. \"result\" is the envelope that readEnvelope gives.",
 "fallback": "The kit does not know this part type, so it does not show the part.",
 "cases": [
  {
   "name": "a final text message of a person",
   "schema": true,
   "envelope": {
    "envelope": 1,
    "agui": "1.0",
    "threadId": "t-1",
    "messageId": "m-1",
    "role": "user",
    "actor": {
     "type": "human",
     "id": "person-a",
     "name": "Person A"
    },
    "state": "final",
    "parts": [
     {
      "type": "text",
      "text": "Is the loan due?"
     }
    ]
   },
   "result": {
    "envelope": 1,
    "agui": "1.0",
    "threadId": "t-1",
    "messageId": "m-1",
    "role": "user",
    "actor": {
     "type": "human",
     "id": "person-a",
     "name": "Person A"
    },
    "state": "final",
    "parts": [
     {
      "type": "text",
      "text": "Is the loan due?"
     }
    ]
   }
  },
  {
